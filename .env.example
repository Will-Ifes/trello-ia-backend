DATABASE_URL="postgresql://postgres:change-me@localhost:5432/trelloia"
# No Neon, configure também DATABASE_URL_UNPOOLED no ambiente de deploy.
# DATABASE_URL usa o hostname -pooler; DATABASE_URL_UNPOOLED usa o hostname direto.
JWT_SECRET="generate-a-long-random-value"
FRONTEND_URL="http://localhost:3030"
PORT=3000
EMAIL_USER=""
EMAIL_PASS=""
OPENROUTER_API_KEY=""
# Escolha um modelo com suporte a JSON no OpenRouter.
OPENROUTER_MODEL=""
# Usado pelo compose.yaml. Troque antes de publicar.
POSTGRES_PASSWORD="change-me"
